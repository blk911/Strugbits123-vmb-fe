# Data Mine — credential assist (server / Vite middleware only)
# COPY to .env.local for local overrides (do not commit real secrets).

# Future: 32+ byte secret for AES-GCM / app-level envelope encryption of provider passwords.
CREDENTIAL_ASSIST_SECRET_KEY=

# Storage backend: "memory" (dev default) | future: "postgres", "secrets_manager", ...
CREDENTIAL_ASSIST_STORE_MODE=memory

# Future: background job interval to mark/delete expired credential assist rows.
CREDENTIAL_ASSIST_TTL_SWEEP_MINUTES=15

# Set to 0 to disable GET /api/deep-dig/credential-assist (breaks admin Credential Assist queue + single-record dev fetch).
# PATCH to mark accessed remains available when the middleware is mounted.
# CREDENTIAL_ASSIST_ALLOW_DEV_GET=0
